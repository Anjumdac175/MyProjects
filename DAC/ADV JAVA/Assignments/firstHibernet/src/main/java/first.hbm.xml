<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC 
    "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
    "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
    
    <hibernate-mapping>
    
    <class name="com.cdac.firstHibernet.entity.Users" table="customers">
 		<id column="username" name="userName" type="java.lang.String"></id>
 		<property column="password" name="password" type="java.lang.String"></property> 
 		<property column="role" name="role" type="java.lang.String"></property>
 		<property column="balance" name="balance" type="java.lang.Double"></property>  
    </class>
    </hibernate-mapping>