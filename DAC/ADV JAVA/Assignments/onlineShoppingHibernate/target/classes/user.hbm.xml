<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC 
    "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
    "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
    
 <hibernate-mapping>
 	<class name="com.cdac.OnlineShoppingHibernate" table="cdac_users">
 	
 		<id column="id" name="id" type="Integer"></id>
 		<property column="username" name="username" type="java.lang.String"></property>
 		<property column ="password" name="password" type="java.lang.String"></property>
 	</class>
 </hibernate-mapping>