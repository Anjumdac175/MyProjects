    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model List<BookManagement.Models.Book>
@{
    ViewBag.Title = "Books List";
    Layout = "_Layout";
}

<div class="container-fluid mt-5">
    <table class="table table-striped-columns shadow">
        <tr>
            <th>BookId</th>
            <th>Title</th>
            <th>Author</th>
            <th>Price</th>
            <th>Publisher</th>
            <th>Actions</th>
        </tr>
        @foreach(var book in Model)
        {
            <tr>
                <td>@book.BookId</td>
                <td>@book.Title</td>
                <td>@book.Author</td>
                <td>@book.Price</td>
                <td>@book.PublisherName</td>
                <td>
                    <a href="/Books/EditBook/@book.BookId" class="btn btn-warning">Edit</a> |
                    <a href="/Books/DeleteBook/@book.BookId" class="btn btn-danger">Delete</a>
                </td>
        </tr>
        }
    </table>
    <div class="mt-3">
        <a href="/Books/CreateBook" class="btn btn-primary">Add Book</a>
    </div>
</div>
