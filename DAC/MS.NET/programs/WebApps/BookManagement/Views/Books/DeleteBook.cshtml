@model BookManagement.Models.Book
@{
    ViewBag.Title = "Delete Book";
    Layout = "_Layout";
}

<div class="container-fluid mt-3">
    <h2 class="fw-bold">Are you Sure you want to delete @Model.Title from Book List?</h2>
    @using (Html.BeginForm())
    {
        @Html.HiddenFor(model => model.BookId);
        <input type="submit" class="btn btn-danger" value="Delete" />
    }
    <div class="mt-3">
        <a href="/Books/BookDetails" class="btn btn-secondary">Cancel</a>
    </div>

</div>
