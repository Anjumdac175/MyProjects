@{
    ViewBag.Title = "Book Management System";
    Layout = "_Layout";
}
<div class="container-fluid align-content-between mt-4">
    <div class="col-8 m-4 p-5 mx-auto shadow border-2 rounded-3 bg-success-subtle">
        <h2 class="text-center fw-bold">Books Management System</h2>
        <div class="d-flex justify-content-center gap-2 mt-3 border-2">
            <a asp-action="CreateBook"  class="btn btn-success btn-lg">Add New Book</a>
            <a asp-action="BookDetails" class="btn btn-primary btn-lg">Show Books</a>
        </div>
    </div>
</div>
