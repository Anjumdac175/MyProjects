@{
    ViewBag.Title = "Student DashBoard";
    Layout = "_MyLayout";
}

<div class="container mt-5">
    <h1 class="text-center fs-1 fw-bold">Student DashBoard</h1>
    <div class="d-flex justify-content-center align-content-around gap-2">
