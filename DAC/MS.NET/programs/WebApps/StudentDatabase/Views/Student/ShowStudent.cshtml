@model List<StudentDatabase.Models.Student>;
@{
    ViewBag.Title = "Student List";
    Layout = "_MyLayout";
}
<h3 class="text-center">Students List</h3>
<div class="container-fluid mt-4">
    <table class="table table-striped-columns">

        <tr>
            <th>Student Id</th>
            <th>Name</th>
            <th>Age</th>
            <th>Email</th>
            <th>Actions</th>
        </tr>
        @foreach (var student in Model)
        {
            <tr>
                <td>@student.RollNo</td>
                <td>@student.Name</td>
                <td>@student.Age</td>
                <td>@student.Email</td>
                <td>
                    <a href="/Student/EditStudent/@student.RollNo">Edit</a> |
                    <a href="/Student/DeleteStudent/@student.RollNo">Delete</a>
                </td>
            </tr>
        }
    </table>
    </div>
</div>

