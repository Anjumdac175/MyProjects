@model StudentDatabase.Models.Student
@{
    ViewBag.Title = "Confirm Deletion Student";
    Layout = "_MyLayout";
}

<div class="container mt-5">
    <h2 class="text-capitalize text-center text-warning">Are you Sure you want to delete this Student? </h2>
    <hr/>
    <div>
        <table class="table table-striped-columns">

            <tr>
                <th>Student Id</th>
                <th>Name</th>
                <th>Age</th>
                <th>Email</th>
            </tr>
                   <tr>
                    <td>@Model.RollNo</td>
                    <td>@Model.Name</td>
                    <td>@Model.Age</td>
                    <td>@Model.Email</td>
                </tr>
        </table>
    </div>
    <form asp-action="DeleteConfirmed" method="post">
        <input type="hidden" asp-for="RollNo" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
    </form>

</div>
