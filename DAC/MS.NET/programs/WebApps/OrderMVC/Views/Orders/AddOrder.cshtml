    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model OrderMVC.Models.OrderModel;
@{
    ViewBag.Title = "Make Order";
    Layout = "_Layout";
}
@Html.AntiForgeryToken()
@if (ViewBag.Message != null)
{
    <div class="alert alert-success mt-3">@ViewBag.Message</div>
}

@using (Html.BeginForm())
{
    <div class="form-group">
        @Html.LabelFor(model => model.CustomerName)
        @Html.TextBoxFor(model => model.CustomerName, new {@class = "form-control"})
        @Html.ValidationMessageFor(model => model.CustomerName)
    </div>
    <div class="form-group">
        @Html.LabelFor(model => model.ItemName)
        @Html.TextBoxFor(model => model.ItemName, new { @class = "form-control" })
        @Html.ValidationMessageFor(model => model.ItemName)
    </div>
    <div class="form-group">
        @Html.LabelFor(model => model.ItemPrice)
        @Html.TextBoxFor(model => model.ItemPrice, new { @class = "form-control", @type = "number" })
        @Html.ValidationMessageFor(model => model.ItemPrice)
    </div>
    <div class="form-group">
        @Html.LabelFor(model => model.ItemQuantity)
        @Html.TextBoxFor(model => model.ItemQuantity, new { @class = "form-control", @type = "number" })
        @Html.ValidationMessageFor(model => model.ItemQuantity)
    </div>

    <div class="mt-3">
        <button class="btn btn-success" type="submit">Place Order</button>
    </div>
    <div class="mt-3">
        <a href="@Url.Action("Index", "Orders")" class="btn btn-primary">Back To Home</a>
    </div>

}
