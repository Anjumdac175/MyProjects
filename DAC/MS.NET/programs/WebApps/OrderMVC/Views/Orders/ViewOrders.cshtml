@model List<OrderMVC.Models.OrderModel>
@{
    ViewBag.Title = "Order List";
    Layout = "_Layout";
}

<h2>Order Search Results</h2>

@if (Model.Count == 0)
{
    <div>No orders found.</div>
}
else
{
    <table class="table table-bordered table-striped">

        <tr>
            <th>Order ID</th>
            <th>Customer Name</th>
            <th>Item Name</th>
            <th>Item Price</th>
            <th>Item Qty</th>
        </tr>
        @foreach (var order in Model)
        {
            <tr>
                <td>@order.OrderId</td>
                <td>@order.CustomerName</td>
                <td>@order.ItemName</td>
                <td>@order.ItemPrice</td>
                <td>@order.ItemQuantity</td>
            </tr>
        }
    </table>
}

<a href="@Url.Action("Index", "Orders")" class="btn btn-primary">Back To Home</a>

